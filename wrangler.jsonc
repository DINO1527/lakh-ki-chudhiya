{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lakh-ki-chudhiya",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "env": {
    "uat": {
      "name": "lakh-ki-chudhiya-uat",
      "workers_dev": true,
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },
      "vars": {
        "APP_ENV": "uat",
      },
    },
    "live": {
      "name": "lakh-ki-chudhiya-live",
      "workers_dev": true,
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },
      "vars": {
        "APP_ENV": "live",
      },
    },
  },
}
