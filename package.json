{
  "name": "lakh-ki-chudhiya",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,css}\" \"public/**/*.{js,html}\" \"scripts/**/*.{js,mjs}\" \"*.{json,jsonc,ts,mjs}\" \".github/workflows/*.yml\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:worker": "node scripts/check-worker-preview.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:uat": "opennextjs-cloudflare deploy --env uat",
    "deploy:live": "opennextjs-cloudflare deploy --env live",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false --include-main-module=false src/types/cloudflare-env.generated.d.ts && prettier --write src/types/cloudflare-env.generated.d.ts"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "0.22.3",
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.81.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@opennextjs/cloudflare": "1.20.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.187.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "wrangler": "4.164.0"
  },
  "pnpm": {
    "overrides": {
      "@jridgewell/trace-mapping": "0.3.31"
    }
  }
}
